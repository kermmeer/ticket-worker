# Ticket Worker's settings. Copy to .env and fill in; INSTALL.md walks through each part.
# With Docker (compose.yml), the database, cache, queue and folders are set for you and
# the lines marked "not with Docker" are ignored.

APP_NAME="Ticket Worker"
APP_ENV=local
# docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The address you open it on.
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One password for the whole app. Leave empty only when something in front of it already
# asks who you are (an SSO proxy, a VPN): without it anyone who can reach the page can read
# your tickets and start agents on your Claude account.
APP_PASSWORD=

# Docker: where the site listens (127.0.0.1 = this machine only; 0.0.0.0 = the network),
# and the user it runs as (`id -u`, `id -g`: the owner of ./data).
APP_BIND=127.0.0.1
APP_PORT=8080
UID=1000
GID=1000
# Behind a reverse proxy that ends TLS: its address, or * (comma-separated).
# TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# The database. With Docker, compose.yml starts a MySQL with these: pick a password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticket_worker
DB_USERNAME=ticket_worker
DB_PASSWORD=

# Not with Docker: it uses the database for all three.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# The one Jira site, read with an API token (CONCEPT.md §13).
JIRA_BASE=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
# dummy: nothing is ever posted to Jira. real: the post and transition buttons reach it.
JIRA_WRITE=dummy
# Open tickets somewhere else than Jira: {key} becomes the ticket key.
# JIRA_OPEN_URL=https://outbox.example.com/{key}
# JIRA_OPEN_LABEL=Outbox

# Optional. An outbox app that takes reply drafts (docs/OUTBOX-API.md). Without one you
# copy a reply into Jira yourself.
OUTBOX_URL=
OUTBOX_API_TOKEN=

# Claude. The key goes to the CLI when a turn runs and is never shown.
ANTHROPIC_API_KEY=
# Or, instead of the key: a token from `claude setup-token` (uses a Claude subscription).
# CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
# Agent turns at once. With Docker, also the number of agent containers.
AGENT_MAX_PARALLEL=2
AGENT_TURN_BUDGET_USD=3
SYNC_EVERY_MINUTES=10

# The systems' folder as the machine you push from sees it, shown in the push commands.
# With Docker: data/systems in this checkout, e.g. you@server:/srv/ticket-worker/data/systems
SYSTEMS_PUSH_BASE=

# Not with Docker. Defaults: a shared/ folder next to the repository.
# CLAUDE_BIN=claude
# CLAUDE_CONFIG_DIR=
# AGENT_WORKSPACES_PATH=
# SYSTEMS_PATH=

VITE_APP_NAME="${APP_NAME}"
