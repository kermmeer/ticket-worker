APP_NAME="Ticket Worker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticket_worker
DB_USERNAME=ticket_worker
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database once the worker containers run (CONCEPT.md §12); sync runs jobs in the request.
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log

# The one Jira site, read with an API token (CONCEPT.md §13).
JIRA_BASE=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
# dummy: nothing is ever posted to Jira. real: the post and transition buttons reach it.
JIRA_WRITE=dummy
# Open tickets somewhere else than Jira: {key} becomes the ticket key.
# JIRA_OPEN_URL=https://jira.techfactory.dev/{key}
# JIRA_OPEN_LABEL=Outbox

# Claude. The key goes to the CLI when a turn runs and is never shown.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
AGENT_MAX_PARALLEL=2
AGENT_TURN_BUDGET_USD=3
SYNC_EVERY_MINUTES=10

# The systems' folder as the machine you push from sees it, for the push commands.
SYSTEMS_PUSH_BASE=kermmeer@minas:/data/apps/ticket-worker-dev/shared/systems

# Defaults: the environment's shared/ folder, next to the repository.
# CLAUDE_BIN=claude
# CLAUDE_CONFIG_DIR=
# AGENT_WORKSPACES_PATH=
# SYSTEMS_PATH=

VITE_APP_NAME="${APP_NAME}"
